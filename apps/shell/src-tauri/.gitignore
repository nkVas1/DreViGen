# Cargo output.
/target/

# Generated by tauri-build from tauri.conf.json and capabilities/ at every build.
/gen/schemas/

# Generated by `tauri android init` / `tauri ios init`. These are platform projects, not
# sources: they are reproducible from tauri.conf.json, and checking them in means merge
# conflicts in Gradle files nobody wrote.
/gen/android/
/gen/apple/
